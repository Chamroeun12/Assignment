# Example Terraform variables for Docker Swarm on AWS EC2
# Copy this file to terraform.tfvars and customize for your deployment environment

aws_region            = "ap-southeast-2"
project_name          = "Assignment"
environment           = "production"
manager_instance_type = "t3.small"
worker_instance_type  = "t3.micro"
worker_count          = 2
allowed_ssh_cidr      = ["0.0.0.0/0"]

# Replace with your actual public key (e.g. cat ~/.ssh/id_ed25519.pub or ~/.ssh/id_rsa.pub)
ssh_public_key        = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExampleKeyForCloudComputingHW2 student@cloud-computing"
